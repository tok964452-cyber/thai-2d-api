{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/live", "dest": "api/live.js" },
    { "src": "/2d_result", "dest": "api/2d_result.js" },
    { "src": "/update_2d", "dest": "api/live.js" },
    { "src": "/(.*)", "dest": "$1" }
  ]
}

